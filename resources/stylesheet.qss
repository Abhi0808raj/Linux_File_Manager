/* Semantic placeholders are resolved from workspace-tokens.json at startup. */
QWidget { color: @on-surface@; font-size: @bodySize@px; }
QMainWindow, QWidget#workspace, QWidget#workspaceContent { background: @surface@; }
QWidget#workspaceSidebar { background: @surface-container@; border-radius: @radius-panel@px; }
QLabel { background: transparent; }
QLabel#workspaceTitle { font-size: @titleSize@px; font-weight: 500; }
QLabel#applicationTitle { font-weight: 500; }
QLabel#pathError { color: @error@; }
QLabel#workspaceSubtitle, QLabel#workspaceStatus, QLabel#sidebarHeading { color: @on-surface-variant@; }
QLabel#sidebarHeading { font-weight: 500; }
QToolBar { background: transparent; border: none; spacing: 8px; }
QPushButton, QToolButton {
    min-height: @controlInnerHeight@px; background: transparent; border: 1px solid transparent;
    border-radius: @radius-large@px; padding: 0px 12px; color: @primary@;
}
QToolButton { padding: 0px 8px; }
QPushButton:hover, QToolButton:hover { background: @surface-container-high@; }
QPushButton:pressed, QToolButton:pressed { background: @primary-container@; }
QPushButton:checked, QToolButton:checked { background: @primary-container@; color: @on-primary-container@; }
QPushButton:focus, QToolButton:focus { border: 1px solid @primary@; }
QPushButton:disabled, QToolButton:disabled { color: @outline@; background: @surface-container@; }
QPushButton#primaryButton { background: @primary@; color: @on-primary@; border-radius: 20px; }
QPushButton#primaryButton:hover { background: @primary-hover@; }
QPushButton#primaryButton:pressed { background: @primary-pressed@; }
QPushButton#primaryButton:focus { border: 1px solid @on-primary@; }
QPushButton#primaryButton:disabled { background: @surface-container-high@; color: @outline@; }
QComboBox {
    min-height: @controlInnerHeight@px; padding: 0px 12px;
    background: @surface@; border: 1px solid @outline-variant@; border-radius: @radius-medium@px;
}
QComboBox:hover { border-color: @outline@; }
QComboBox:focus { border-color: @primary@; }
QComboBox:disabled { background: @surface-container@; color: @outline@; }
QLineEdit {
    min-height: @controlInnerHeight@px; padding: 0px 12px; background: @surface@;
    border: 1px solid @outline-variant@; border-radius: @radius-medium@px;
    selection-background-color: @primary-container@; selection-color: @on-primary-container@;
}
QLineEdit:hover { border-color: @outline@; }
QLineEdit:focus { border: 1px solid @primary@; }
QLineEdit:disabled { background: @surface-container@; color: @outline@; }
QLineEdit[invalid="true"] { border-color: @error@; }
QAbstractItemView {
    background: @surface@; border: none; outline: none;
    selection-background-color: @primary-container@; selection-color: @on-primary-container@;
}
QAbstractItemView::item { min-height: @rowHeight@px; border: 1px solid transparent; }
QAbstractItemView::item:hover { background: @surface-container@; }
QAbstractItemView::item:selected { background: @primary-container@; color: @on-primary-container@; }
QAbstractItemView::item:focus { border: 1px solid @primary@; }
QAbstractItemView:focus { border: 1px solid @primary@; }
QListWidget#placesList { background: transparent; border: none; }
QListWidget#placesList:focus { border: 1px solid @primary@; }
QListWidget#placesList::item { min-height: @navHeight@px; padding: 0px 12px; border-radius: 22px; }
QListWidget#placesList::item:hover { background: @surface-container-high@; }
QListWidget#placesList::item:selected { background: @primary-container@; color: @on-primary-container@; }
QListWidget#placesList::item:focus { border: 1px solid @primary@; }
QHeaderView::section {
    background: @surface@; color: @on-surface-variant@; border: none;
    border-bottom: 1px solid @outline-variant@; padding: 12px 8px; font-weight: 500;
}
QStatusBar { background: @surface@; color: @on-surface-variant@; border-top: 1px solid @outline-variant@; }
QStatusBar::item { border: none; }
QMenu { background: @surface@; border: 1px solid @outline-variant@; padding: 4px; }
QMenu::item { padding: 8px 24px; border-radius: @radius-small@px; }
QMenu::item:selected { background: @primary-container@; color: @on-primary-container@; }
QMenu::item:disabled { color: @outline@; }
QScrollBar:vertical { background: transparent; width: 12px; margin: 0px; }
QScrollBar:horizontal { background: transparent; height: 12px; margin: 0px; }
QScrollBar::handle { background: @outline-variant@; border-radius: 5px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: @outline@; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QToolTip { background: @surface-container-high@; color: @on-surface@; border: 1px solid @outline-variant@; padding: 6px; }

QTabBar#folderTabs::tab { background: transparent; border: 1px solid transparent; border-radius: @radius-medium@px; padding: 7px 8px; margin-right: 12px; width: 150px; height: 24px; }
QTabBar#folderTabs::tab:selected { background: @primary-container@; color: @on-primary-container@; }
QTabBar#folderTabs::tab:hover { background: @surface-container-high@; }
QTabBar#folderTabs:focus { border: 1px solid @primary@; border-radius: @radius-medium@px; }
QTabBar#folderTabs QToolButton { min-height: 0px; padding: 0px; border-radius: 4px; }

QLineEdit#folderSearch { min-height: 46px; max-height: 46px; background: @surface-container@; border: 1px solid @outline@; border-radius: @radius-medium@px; padding: 0px 8px; }
QLineEdit#folderSearch:focus { border: 1px solid @primary@; }
QLabel#searchState { color: @on-surface-variant@; }
