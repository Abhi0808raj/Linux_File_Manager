/* Modern Light Theme for File Manager */

/* General */
QWidget {
    background-color: #FFFFFF;
    color: #2C2C2C;
    font-family: "Segoe UI", "Ubuntu", "Roboto", Arial, sans-serif;
    font-size: 13px;
}

/* Main Window */
QMainWindow {
    background-color: #F8F9FA;
}

/* ToolBar - Navigation Bar */
QToolBar {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E1E5E9;
    padding: 8px 12px;
    spacing: 6px;
    min-height: 40px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid #E1E5E9;
    border-radius: 6px;
    padding: 8px 12px;
    min-width: 32px;
    min-height: 32px;
    margin: 0px 2px;
}

QToolButton:hover {
    background-color: #F1F3F4;
    border-color: #D1D7DB;
}

QToolButton:pressed {
    background-color: #E8EAED;
    border-color: #C1C7CB;
}

QToolButton:disabled {
    background-color: #F8F9FA;
    border-color: #E8EAED;
    color: #9AA0A6;
}

/* MenuBar */
QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E1E5E9;
    padding: 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 8px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #F1F3F4;
}

QMenuBar::item:pressed {
    background-color: #E8EAED;
}

/* Menu */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E1E5E9;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 16px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #E8F0FE;
    color: #1A73E8;
}

/* TableView - Main File List */
QTableView {
    background-color: #FFFFFF;
    border: 1px solid #E1E5E9;
    border-radius: 8px;
    gridline-color: transparent;
    alternate-background-color: #F8F9FA;
    selection-background-color: #E8F0FE;
    margin: 8px;
}

QTableView::item {
    padding: 12px 8px;
    border-bottom: 1px solid #F1F3F4;
}

QTableView::item:selected {
    background-color: #E8F0FE;
    color: #1A73E8;
}

QTableView::item:hover {
    background-color: #F8F9FA;
}

/* Header for TableView */
QHeaderView {
    background-color: #F8F9FA;
    border: none;
    border-bottom: 2px solid #E1E5E9;
}

QHeaderView::section {
    background-color: #F8F9FA;
    color: #5F6368;
    padding: 12px 8px;
    border: none;
    border-right: 1px solid #E1E5E9;
    font-weight: 500;
    text-transform: uppercase;
    font-size: 11px;
}

QHeaderView::section:hover {
    background-color: #F1F3F4;
}

QHeaderView::section:first {
    border-top-left-radius: 8px;
}

QHeaderView::section:last {
    border-right: none;
    border-top-right-radius: 8px;
}

/* Dock Widget (Sidebar) */
QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    background-color: #F8F9FA;
    border-right: 1px solid #E1E5E9;
}

QDockWidget::title {
    background-color: #F8F9FA;
    text-align: left;
    padding: 12px 16px;
    font-weight: 600;
    color: #5F6368;
    border-bottom: 1px solid #E1E5E9;
}

QDockWidget QWidget {
    background-color: #F8F9FA;
}

/* TreeWidget - Sidebar Navigation */
QTreeWidget {
    background-color: #F8F9FA;
    border: none;
    outline: none;
    padding: 8px 0px;
}

QTreeWidget::item {
    padding: 8px 16px;
    border: none;
    margin: 2px 8px;
    border-radius: 6px;
}

QTreeWidget::item:selected {
    background-color: #E8F0FE;
    color: #1A73E8;
}

QTreeWidget::item:hover {
    background-color: #F1F3F4;
}

QTreeWidget::branch {
    background: transparent;
}

QTreeWidget::branch:has-children:closed {
    image: url(:/icons/folder.svg);
}

QTreeWidget::branch:has-children:open {
    image: url(:/icons/folder.svg);
}

/* ScrollBars */
QScrollBar:vertical {
    border: none;
    background: #F8F9FA;
    width: 12px;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #DADCE0;
    min-height: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #BDC1C6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #F8F9FA;
    height: 12px;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #DADCE0;
    min-width: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #BDC1C6;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* StatusBar */
QStatusBar {
    background-color: #F8F9FA;
    border-top: 1px solid #E1E5E9;
    padding: 4px 12px;
    color: #5F6368;
}

/* Splitter */
QSplitter::handle {
    background-color: #E1E5E9;
    width: 1px;
    height: 1px;
}

QSplitter::handle:hover {
    background-color: #DADCE0;
}

/* Search Box (if you add one) */
QLineEdit {
    background-color: #F1F3F4;
    border: 1px solid #E1E5E9;
    border-radius: 20px;
    padding: 8px 16px;
    font-size: 14px;
}

QLineEdit:focus {
    background-color: #FFFFFF;
    border-color: #1A73E8;
    outline: none;
}

/* Buttons */
QPushButton {
    background-color: #1A73E8;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #1557B0;
}

QPushButton:pressed {
    background-color: #1347A0;
}